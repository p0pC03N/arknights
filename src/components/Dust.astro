<canvas id="canvas-dust" aria-hidden="true"></canvas>

<script type="module">
  const canvas = document.getElementById("canvas-dust");

  // 尊重“减少动态效果”
  const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
  if (!reduce && canvas) {
    const mod = await import("../scripts/dust.js");
    mod.startDust(canvas);
  }
</script>

<style>
  #canvas-dust{
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0; /* 让内容盖在它上面 */
  }
</style>
