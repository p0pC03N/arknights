---
interface Props {
  title: string;
  subTitle: string;
  total: number;
  accent?: "amber" | "blue";
  note?: string;
}

const {
  title,
  subTitle,
  total,
  accent = "blue",
  note,
} = Astro.props as Props;

const accentClass =
  accent === "amber"
    ? "border-yellow-300/25 bg-yellow-300/10 text-yellow-100"
    : "border-sky-300/25 bg-sky-300/10 text-sky-100";

const glowClass = accent === "amber" ? "glow-amber" : "glow-blue";
---

<section class={`relative overflow-hidden rounded-[1.6rem] border border-white/10 bg-black/30 px-7 py-6 panel-grid panel-noise backdrop-blur-md glow-frame ${glowClass}`}>
  <div class="relative flex flex-wrap items-center justify-between gap-4">
    <div>
      <div class="text-[0.72rem] font-benderBold tracking-[0.38em] text-white/45">{subTitle}</div>
      <div class="mt-2 text-[2.1rem] font-benderBold tracking-[0.08em] text-white portrait:text-[1.6rem]">
        {title}
      </div>
      {note && <div class="mt-3 text-[0.92rem] text-white/55">{note}</div>}
    </div>

    <div class={`rounded-full border px-4 py-2 text-[0.72rem] font-benderBold tracking-[0.32em] ${accentClass}`}>
      DOSSIERS // {String(total).padStart(2, "0")}
    </div>
  </div>
</section>
