---
import type { SubNavigationItem } from "../_types/SubNavigationItem";
import arknightsConfig from "../../arknights.config";
import "../_styles/base.css";
import FontFace from "../_styles/FontFace.astro";
import Scrollbar from "../_styles/Scrollbar.astro";
import ResponsiveFontSize from "../components/ResponsiveFontSize.astro";
import Header from "../components/header/Header.astro";
import { Menu } from "../components/header/NavMenu";
import ToolBox from "../components/ToolBox";
import OwnerInfo from "../components/OwnerInfo";
import { SvgDefs } from "../components/SvgIcons";

interface Props {
  lang?: string;
  title?: string;
  description?: string;
  subNavigationItems?: SubNavigationItem[];
}

const base = import.meta.env.BASE_URL;
const { lang, title, description, subNavigationItems } = Astro.props as Props;
const pageLang = lang ?? arknightsConfig.language;
const pageDescription = description ?? arknightsConfig.description;
const siteTitle = arknightsConfig.title;
const pageTitle = !title || title === siteTitle ? siteTitle : `${title} - ${siteTitle}`;
---

<!DOCTYPE html>
<html lang={pageLang} class="h-full bg-black" style="font-size: 16px">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    <meta name="generator" content={Astro.generator} />
    <base target="_blank" />
    <title>{pageTitle}</title>

    <FontFace />
    <Scrollbar />
    <ResponsiveFontSize />

    <!-- ✅ 新鼠标实现：arknights-cursor（用 base，兼容 GitHub Pages 子路径） -->
    <link rel="stylesheet" href={base + "effects/arknights-cursor/cursor.css"} />

    <!-- ✅ 背景尘埃 canvas 的最小样式（不挡点击，铺满全屏） -->
    <style>
      #canvas-dust{
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
      }
      /* 让页面内容盖在尘埃层上面 */
      .site-layer{
        position: relative;
        z-index: 1;
      }
    </style>
  </head>

  <body class="w-full h-full text-white bg-black m-0 overflow-hidden">
    <!-- ✅ 背景尘埃：放 body 最前面 -->
    <canvas id="canvas-dust" aria-hidden="true"></canvas>

    <!-- ✅ 你原本的页面内容（加一层 site-layer 提升 z-index） -->
    <div class="w-full h-full relative bg-layout bg-center bg-cover bg-no-repeat site-layer">
      <div class="relative w-full h-full m-auto max-w-[180rem]">
        <Header />
        <slot />
        <Menu client:only="react" {...{ subNavigationItems }} />
        <ToolBox client:load />
        <OwnerInfo client:load />
      </div>
    </div>

    <SvgDefs />

    <!-- ✅ 新鼠标实现：arknights-cursor -->
    <script src={base + "effects/arknights-cursor/cursor.js"} defer></script>

    <!-- ✅ 背景尘埃脚本（你要放到 public/effects/dust/dust.js） -->
    <script src={base + "effects/dust/dust.js"} defer></script>
  </body>
</html>
