---
import type { MarkdownHeading } from "astro";
import InfoLayout from "./InfoLayout.astro";
import DocsLeftAside from "../components/DocsLeftAside.astro";
import DocsLeftAsideSwitch from "../components/DocsLeftAsideSwitch";
import DocumentIndexUL from "../components/DocumentIndexUL.astro";
import DocsToolPanel from "../components/DocsToolPanel";
import { getDocsSubNavigationItems } from "../components/DocsCollectionsUtils";

interface Props {
  title?: string;
  headings?: MarkdownHeading[];
  currentSlug?: string;
  showKnowledgeMap?: boolean;
}

const {
  title,
  headings,
  currentSlug,
  showKnowledgeMap = true,
} = Astro.props as Props;

const tabTitle = title ? `${title} - 文档` : "文档";
const subNavigationItems = getDocsSubNavigationItems();
---

<InfoLayout title="DOCS" subTitle="文档" {...{ tabTitle, subNavigationItems }}>
  {
    showKnowledgeMap && (
      <nav
        slot="left-aside"
        id="docs-map-shell"
        class="docs-map-shell relative h-full overflow-hidden rounded-r-[1.4rem] border-r border-sky-300/20 bg-[#071019]/92 mix-blend-screen panel-grid flex flex-col backdrop-blur-md"
      >
        <DocsLeftAside currentSlug={currentSlug} />
        <DocsLeftAsideSwitch client:load />
      </nav>
    )
  }

  <div
    id="docs-content"
    class="max-w-[80.75rem] h-full mx-auto overflow-y-auto rounded-[2rem] border border-white/10 bg-[#071019]/58 px-6 py-6 panel-grid backdrop-blur-md transition-[height] duration-300 portrait:px-4"
  >
    {
      headings && headings.length > 0 && (
        <details class="pb-8 landscape:hidden">
          <summary class="rounded-full border border-sky-300/25 bg-sky-300/10 px-4 py-2 text-black text-[24px] font-bold font-oswaldMedium">
            Document Index - 文档索引
          </summary>
          <DocumentIndexUL {...{ headings }} />
        </details>
      )
    }
    <slot />
  </div>

  {
    headings && headings.length > 0 && (
      <nav slot="aside-header" class="rounded-[1.5rem] border border-white/10 bg-[#071019]/55 panel-grid p-5 backdrop-blur-md">
        <div class="text-[0.72rem] font-benderBold tracking-[0.35em] text-sky-100/55">DOCUMENT INDEX</div>
        <h2 class="mt-3 text-[1.65rem] font-benderBold tracking-[0.08em] text-white">章节节点</h2>
        <div class="mt-5">
          <DocumentIndexUL {...{ headings }} />
        </div>
      </nav>
    )
  }

  <DocsToolPanel slot="tool-panel" client:load />
</InfoLayout>
