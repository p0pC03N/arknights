---
import friends from "../data/friend-links.json";
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <link rel="stylesheet" href={base + "effects/arknights-cursor/cursor.css"} />
    <title>Stargate · Corn Kingdom</title>
    <style>
      :root { color-scheme: dark; font-family: "Iowan Old Style", "Palatino Linotype", Georgia, "Songti SC", serif; color: #f5eddd; background: #05040b; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100svh; overflow: hidden; background: radial-gradient(ellipse at 50% 46%, #21152e88, transparent 62%), #05040b; }
      body::after { content: ""; position: fixed; inset: 0; pointer-events: none; box-shadow: inset 0 0 16vw #020106; }
      #stargate { position: fixed; inset: 0; width: 100%; height: 100%; }
      .masthead { position: fixed; top: max(2.5rem, env(safe-area-inset-top)); width: 100%; text-align: center; }
      .eyebrow { margin: 0; color: #d5b77c; font-size: .64rem; letter-spacing: .42em; font-weight: 400; }
      .masthead p { margin: .8rem 0; color: #a99db3; font-size: clamp(.55rem, 2vw, .75rem); letter-spacing: .2em; padding: 0 1rem; }
      #destination { position: fixed; inset: 0; display: grid; place-content: center; text-align: center; pointer-events: none; opacity: 0; transform: translateY(12px); transition: opacity .24s, transform .24s; }
      #destination.visible { opacity: 1; transform: translateY(0); }
      h1 { font-size: clamp(1.5rem, 5vw, 2.6rem); font-weight: 400; letter-spacing: .08em; margin: 1rem .5rem; overflow-wrap: anywhere; }
      #host { color: #a99db3; font-size: .65rem; letter-spacing: .16em; }
      .footer { position: fixed; bottom: max(2rem, env(safe-area-inset-bottom)); width: 100%; text-align: center; z-index: 1; padding: 0 1rem; }
      #phase { color: #a99db3; font-size: .78rem; letter-spacing: .22em; margin-bottom: 1.2rem; }
      a { color: #dcc18d; text-decoration: none; font-size: .75rem; letter-spacing: .12em; padding: .4rem; border-bottom: 1px solid #dcc18d44; }
      a:hover { color: #fff1d3; border-color: #dcc18d; }
      a:focus-visible { outline: 2px solid #dcc18d; outline-offset: 5px; }
      #fallback nav { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
      [hidden] { display: none !important; }
      @media (max-height: 500px) { .masthead { top: 1rem; } .masthead p { display: none; } .footer { bottom: 1rem; } }
      @media (prefers-reduced-motion: reduce) { #destination { transition: none; } }
    </style>
  </head>
  <body>
    <canvas id="stargate" aria-hidden="true"></canvas>
    <header class="masthead">
      <h2 class="eyebrow">CORN KINGDOM / ARCANA</h2>
      <p>FOLLOW THE STARS · FIND YOUR PEOPLE</p>
    </header>
    <main id="destination" aria-live="polite">
      <p class="eyebrow">BEYOND THE ARCANA</p>
      <h1 id="friend-name"></h1>
      <span id="host"></span>
    </main>
    <footer class="footer">
      <p id="phase">The gate is awakening</p>
      <a id="continue" hidden rel="noreferrer">Step through now ↗</a>
      <div id="fallback">
        <nav aria-label="Kindred Worlds">{friends.map((friend) => <a href={friend.url} rel="noreferrer">{friend.name} ↗</a>)}</nav>
        <p><a href={base + "#operator"}>Return to the Arcana</a></p>
      </div>
    </footer>
    <script src="../scripts/friend-links-gate.js"></script>
    <script is:inline src={base + "effects/arknights-cursor/cursor.js"} defer></script>
</body>
</html>
