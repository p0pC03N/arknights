---
import friends from "../data/friend-links.json";
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Arcana · Corn Kingdom</title>
  <meta name="robots" content="noindex" />
  <link rel="stylesheet" href={base + "effects/arknights-cursor/cursor.css"} />
  <style>
    :root {
      color-scheme: dark;
      --gold: #f4d59a;
      --ink: #f5f1eb;
      --muted: rgba(245, 241, 235, 0.66);
      --panel: rgba(10, 8, 18, 0.48);
      --panel-border: rgba(244, 213, 154, 0.18);
      --shadow: 0 22px 70px rgba(0, 0, 0, 0.4);
      font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    }

    * { box-sizing: border-box; }

    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background:
        radial-gradient(circle at 20% 18%, rgba(89, 61, 144, 0.18), transparent 24%),
        radial-gradient(circle at 78% 24%, rgba(244, 213, 154, 0.07), transparent 24%),
        radial-gradient(circle at 50% 76%, rgba(143, 169, 255, 0.05), transparent 28%),
        linear-gradient(180deg, #09060f, #020204 76%);
      color: var(--ink);
    }

    body::before,
    body::after {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
    }

    body::before {
      background:
        radial-gradient(circle at 12% 18%, rgba(255,255,255,0.18) 0 0.05rem, transparent 0.11rem),
        radial-gradient(circle at 34% 12%, rgba(255,255,255,0.12) 0 0.05rem, transparent 0.11rem),
        radial-gradient(circle at 63% 16%, rgba(255,255,255,0.16) 0 0.05rem, transparent 0.11rem),
        radial-gradient(circle at 86% 24%, rgba(255,255,255,0.12) 0 0.06rem, transparent 0.11rem);
      opacity: 0.42;
    }

    body::after {
      background:
        radial-gradient(circle at center, transparent 0 56%, rgba(0, 0, 0, 0.56) 100%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.18), transparent 20%, transparent 80%, rgba(0, 0, 0, 0.34));
    }

    button {
      border: 0;
      font: inherit;
      color: inherit;
      background: none;
      cursor: pointer;
    }

    #scene-root {
      position: fixed;
      inset: 0;
      z-index: 1;
    }

    #ui-layer {
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }

    .whisper {
      position: absolute;
      left: 50%;
      bottom: clamp(0.9rem, 2vw, 1.3rem);
      transform: translateX(-50%);
      width: min(27rem, calc(100vw - 1.8rem));
      padding: 0.8rem 1rem;
      border: 1px solid var(--panel-border);
      background: rgba(8, 6, 16, 0.28);
      backdrop-filter: blur(12px);
      box-shadow: var(--shadow);
      text-align: center;
    }

    .whisper-title {
      color: var(--gold);
      font-size: 0.68rem;
      letter-spacing: 0.32em;
      text-transform: uppercase;
    }

    .whisper-text {
      margin-top: 0.32rem;
      font-size: 0.84rem;
      line-height: 1.55;
      color: var(--muted);
    }

    .nameplate {
      position: absolute;
      left: 50%;
      top: 15%;
      transform: translateX(-50%);
      width: min(22rem, calc(100vw - 2rem));
      text-align: center;
      opacity: 0;
      visibility: hidden;
      transition: opacity 220ms ease, visibility 220ms ease;
    }

    .nameplate.is-visible {
      opacity: 1;
      visibility: visible;
    }

    .nameplate-kicker {
      color: var(--gold);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-size: 0.68rem;
    }

    .nameplate-title {
      margin-top: 0.28rem;
      font-size: clamp(1.3rem, 3vw, 2rem);
      letter-spacing: 0.1em;
    }

    .nameplate-state {
      margin-top: 0.24rem;
      color: var(--muted);
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    #loading {
      position: fixed;
      inset: 0;
      z-index: 5;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at center, rgba(117, 90, 196, 0.18), transparent 34%),
        rgba(4, 3, 8, 0.94);
      transition: opacity 600ms ease, visibility 600ms ease;
    }

    #loading.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .loading-card {
      width: min(24rem, calc(100vw - 2rem));
      padding: 1.6rem 1.5rem;
      border: 1px solid rgba(244, 213, 154, 0.22);
      background: rgba(11, 9, 22, 0.82);
      text-align: center;
      box-shadow: var(--shadow);
    }

    .loading-kicker {
      color: var(--gold);
      font-size: 0.68rem;
      letter-spacing: 0.32em;
      text-transform: uppercase;
    }

    .loading-title {
      margin-top: 0.8rem;
      font-size: clamp(1.4rem, 4vw, 2.1rem);
      line-height: 1.2;
    }

    .loading-text {
      margin-top: 0.8rem;
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.9rem;
    }

    @media (max-width: 720px) {
      .whisper {
        width: calc(100vw - 1rem);
        bottom: 0.6rem;
      }

    }
    #scene-root { touch-action: none; }
    #quick-links { position: fixed; left: 1rem; bottom: 1rem; z-index: 3; color: var(--muted); font-size: .75rem; }
    #quick-links summary { cursor: pointer; padding: .6rem; }
    #quick-links[open] { background: #100c1e; border: 1px solid var(--panel-border); border-radius: .4rem; }
    nav { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; padding: .8rem; }
    a { color: var(--gold); text-underline-offset: .25em; }
    #retry { margin-top: 1rem; padding: .6rem 1rem; border: 1px solid var(--panel-border); }
    :focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
    @media (max-width: 720px) {
      .whisper { bottom: 3.2rem; }
      .nameplate { top: 12%; }
    }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  </style>
</head>
<body>
  <div id="scene-root"></div>

  <div id="ui-layer">
    <div id="nameplate" class="nameplate">
      <div class="nameplate-kicker">Arcana</div>
      <div id="nameplate-title" class="nameplate-title"></div>
      <div id="nameplate-state" class="nameplate-state"></div>
    </div>

    <div class="whisper">
      <div id="whisper-title" class="whisper-title">The Arcana</div>
      <div id="whisper-text" class="whisper-text">Drag or scroll to explore · Click to reveal</div>
    </div>

  </div>

  <div id="loading">
    <div class="loading-card">
      <div class="loading-kicker">Conjuring</div>
      <div class="loading-title" id="loading-title">Awakening the deck</div>
      <div class="loading-text" id="loading-text">Gathering stardust. A moment, please…</div>
      <div id="load-recovery" hidden>
        <button id="retry" type="button">Try again</button>
        <nav aria-label="Kindred Worlds">{friends.map((friend) => <a href={friend.url} target="_blank" rel="noopener noreferrer">{friend.name}</a>)}</nav>
      </div>
      <noscript><p>Enable JavaScript to reveal the cards, or visit a world below:</p>{friends.map((friend) => <a href={friend.url} target="_blank" rel="noopener noreferrer">{friend.name} </a>)}</noscript>
    </div>
  </div>
  <details id="quick-links">
    <summary>Kindred Worlds</summary>
    <nav aria-label="Kindred Worlds">{friends.map((friend) => <a href={friend.url} target="_blank" rel="noopener noreferrer">{friend.name}</a>)}</nav>
  </details>

  <script is:inline>
    (() => {
      const loading = document.getElementById("loading");
      let settled = false;
      const fail = () => {
        if (settled) return;
        settled = true;
        document.documentElement.dataset.arcanaFailed = "true";
        document.getElementById("loading-title").textContent = "The deck is out of reach";
        document.getElementById("loading-text").textContent = "The stars could not align. Try again, or visit a kindred world directly.";
        document.getElementById("load-recovery").hidden = false;
      };
      const timeout = setTimeout(fail, 10000);
      window.addEventListener("arcana:ready", () => {
        if (settled) return;
        settled = true;
        clearTimeout(timeout);
        loading.classList.add("is-hidden");
      }, { once: true });
      window.addEventListener("arcana:error", () => {
        settled = false;
        loading.classList.remove("is-hidden");
        clearTimeout(timeout);
        fail();
      });
      document.getElementById("retry").addEventListener("click", () => location.reload());
    })();
  </script>
  <script src="../scripts/friend-links-scene.js"></script>
  <script is:inline src={base + "effects/arknights-cursor/cursor.js"} defer></script>
</body>
</html>
