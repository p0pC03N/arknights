---
import {getCollection} from "astro:content";
// import {Debug} from 'astro:components'
import InfoLayout from "../../layouts/InfoLayout.astro";
import GoBackTool from "../../components/GoBackTool";
import { filterPublishedEntries, sortBlogEntries } from "../../content/utils";
import ArticleCatReward from "../../components/cat/ArticleCatReward";

export async function getStaticPaths() {
    const allBlog = sortBlogEntries(filterPublishedEntries(await getCollection("blog")));

    return allBlog.map(entry => ({
        params: {slug: entry.slug},
        props: {entry}
    }))
}

const {entry} = Astro.props;
const {Content} = await entry.render();
const goBackHref = import.meta.env.BASE_URL + "blog"
const tabTitle = entry?.data?.title ?? "无标题"
---

<InfoLayout title="BLOG" subTitle="博客" {...{tabTitle}}>
    <article class="max-w-[80.75rem] mx-auto">
        <Content/>
    </article>
    <ArticleCatReward client:load articleId={`blog:${entry.slug}`} />
    <!--<Debug {entry} />-->

    <GoBackTool slot="tool-panel" client:load {...{goBackHref}}/>
</InfoLayout>
