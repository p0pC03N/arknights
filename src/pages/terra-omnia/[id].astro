---
import DocsLayout from "../../layouts/DocsLayout.astro";
import EncryptedArticle from "../../components/EncryptedArticle";

export async function getStaticPaths() {
  // ✅ 不依赖外部变量/函数，避免编译重排导致未定义
  const payloadModules = import.meta.glob<{ default: any }>(
    "/src/content/secret/*.payload.json",
    { eager: true }
  );

  return Object.keys(payloadModules).map((p) => {
    const file = p.split("/").pop() ?? "";
    const id = file.replace(/\.payload\.json$/i, "");
    return { params: { id } };
  });
}

const { id } = Astro.params;

// 这里给页面渲染用，可以再 glob 一次（不影响构建性能，文件量很小）
const payloadModules = import.meta.glob<{ default: any }>(
  "/src/content/secret/*.payload.json",
  { eager: true }
);

const entry = Object.entries(payloadModules).find(([p]) => {
  const file = p.split("/").pop() ?? "";
  return file === `${id}.payload.json`;
});

const payload = entry?.[1]?.default;
const title = id ? `封存档案 ${id}` : "加密文档";
const headings: any[] = [];
---

<DocsLayout title={title} headings={headings} showKnowledgeMap={false}>
  {
    payload ? (
      <EncryptedArticle client:load payload={payload} autoDecrypt={false} title={title} />
    ) : (
      <article>
        <h2>未找到加密文档</h2>
        <p>请确认存在：<code>src/content/secret/{id}.payload.json</code></p>
      </article>
    )
  }
</DocsLayout>

