---
import DocsLayout from "../../layouts/DocsLayout.astro";
import EncryptedArticle from "../../components/EncryptedArticle";

// 读取你现有脚本产出的 payload：src/content/secret/<id>.payload.json
const payloadModules = import.meta.glob<{
  default: any;
}>("/src/content/secret/*.payload.json", { eager: true });

export async function getStaticPaths() {
  const paths = Object.keys(payloadModules).map((p) => {
    const file = p.split("/").pop() ?? "";
    const id = file.replace(/\.payload\.json$/i, "");
    return { params: { id } };
  });
  return paths;
}

const { id } = Astro.params;
const mod = Object.entries(payloadModules).find(([p]) => (p.split("/").pop() ?? "").startsWith(id + ".payload"));
const payload = mod?.[1]?.default;

const title = id ?? "加密文档";
const headings: any[] = [];
---

<DocsLayout title={title} headings={headings}>
  {
    payload ? (
      // 说明：解密逻辑完全复用你现成的 EncryptedArticle + encrypt-doc.mjs 产出格式
      <EncryptedArticle client:load payload={payload} autoDecrypt={true} />
    ) : (
      <article>
        <h2>未找到加密文档</h2>
        <p>请确认是否存在：<code>src/content/secret/{id}.payload.json</code></p>
      </article>
    )
  }
</DocsLayout>
