---
import DocsLayout from "../../layouts/DocsLayout.astro";
import EncryptedArticle from "../../components/EncryptedArticle";

// 用函数包装，避免 getStaticPaths 被提取/重排后拿不到变量（函数声明会被提升）
function loadPayloadModules() {
  return import.meta.glob<{ default: any }>(
    "/src/content/secret/*.payload.json",
    { eager: true }
  );
}

export async function getStaticPaths() {
  const payloadModules = loadPayloadModules();
  return Object.keys(payloadModules).map((p) => {
    const file = p.split("/").pop() ?? "";
    const id = file.replace(/\.payload\.json$/i, "");
    return { params: { id } };
  });
}

const { id } = Astro.params;
const payloadModules = loadPayloadModules();
const mod = Object.entries(payloadModules).find(([p]) =>
  (p.split("/").pop() ?? "").startsWith(id + ".payload")
);
const payload = mod?.[1]?.default;

const title = id ?? "加密文档";
const headings: any[] = [];
---

<DocsLayout title={title} headings={headings}>
  {
    payload ? (
      <EncryptedArticle client:load payload={payload} autoDecrypt={true} />
    ) : (
      <article>
        <h2>未找到加密文档</h2>
        <p>请确认是否存在：<code>src/content/secret/{id}.payload.json</code></p>
      </article>
    )
  }
</DocsLayout>

